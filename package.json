{
  "name": "chmkit",
  "version": "1.0.0",
  "description": "A TypeScript library for reading, parsing, and compressing .chm files with command-line tools",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "browser": "./dist/browser/root.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/types/browser-root.d.mts",
        "default": "./dist/browser/root.mjs"
      },
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./browser": {
      "types": "./dist/types/browser.d.mts",
      "default": "./dist/browser/index.mjs"
    },
    "./config": {
      "import": {
        "types": "./dist/types/config.d.mts",
        "default": "./dist/esm/config.mjs"
      },
      "require": {
        "types": "./dist/types/config.d.cts",
        "default": "./dist/cjs/config.js"
      }
    },
    "./reader": {
      "browser": {
        "types": "./dist/types/browser.d.mts",
        "default": "./dist/browser/index.mjs"
      },
      "import": {
        "types": "./dist/types/reader.d.mts",
        "default": "./dist/esm/reader.mjs"
      },
      "require": {
        "types": "./dist/types/reader.d.cts",
        "default": "./dist/cjs/reader.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "chm": "./dist/cjs/cli/index.js",
    "chmkit": "./dist/cjs/cli/index.js"
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/browser",
    "dist/types",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx watch src/cli/index.ts",
    "lint": "eslint src test \"*.config.*ts\" --ext .ts,.mts",
    "lint:fix": "eslint src test \"*.config.*ts\" --ext .ts,.mts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:browser": "playwright test",
    "test:package": "vitest run --project package",
    "test:all": "pnpm test && pnpm test:browser",
    "demo": "pnpm build && node scripts/demo.mjs",
    "prepack": "pnpm build",
    "test:watch": "vitest --project node",
    "clean": "rimraf dist test-results coverage"
  },
  "keywords": [
    "chm",
    "chm-reader",
    "chm-parser",
    "chm-extractor",
    "typescript",
    "cli",
    "lzx",
    "huffman",
    "decompression",
    "compression"
  ],
  "author": "CHMKit Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@playwright/test": "1.64.1",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.2.3",
    "tsx": "^4.5.0",
    "typescript": "~5.2.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@types/node": "^20.19.6",
    "buffer": "^6.0.3",
    "chalk": "^5.4.1",
    "commander": "^11.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
